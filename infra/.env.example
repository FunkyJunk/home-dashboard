PORT=3000

# Home Assistant - generate a long-lived access token from your HA profile page
HOME_ASSISTANT_URL=http://homeassistant:8123
HOME_ASSISTANT_TOKEN=

# Weather (Open-Meteo, no key needed - just coordinates)
LAT=
LON=

# Google Calendar / Gmail OAuth (from get-refresh-token.js)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Apple Reminders (Tasks widget) - CalDAV over caldav.icloud.com.
# App-specific password from appleid.apple.com -> Sign-In and Security.
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=

# Receipt line-item/total extraction (console.anthropic.com -> API keys).
# Optional - without it, receipt scanning falls back to regex-based
# extraction, which misses items in many vendor email formats.
ANTHROPIC_API_KEY=
