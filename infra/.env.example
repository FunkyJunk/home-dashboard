PORT=3000

# Home Assistant - generate a long-lived access token from your HA profile page
HOME_ASSISTANT_URL=http://homeassistant:8123
HOME_ASSISTANT_TOKEN=

# Weather (Open-Meteo, no key needed - just coordinates)
LAT=
LON=

# Google Calendar / Gmail OAuth (from get-refresh-token.js)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Todoist (Tasks widget) - REST API token from todoist.com Settings -> Developer.
TODOIST_TOKEN=

# Plex Media Server (Roku Devices card) - only needed for the rich
# poster/title/watched-left-end metadata shown when a Roku is playing
# Plex specifically; every other app just shows its name (Roku's own API
# doesn't expose more than that for any other app). Get the token by
# signing into app.plex.tv, opening any item, ... -> Get Info -> View XML,
# and copying X-Plex-Token from the resulting URL.
PLEX_URL=http://192.168.1.97:32400
PLEX_TOKEN=

# Receipt line-item/total extraction (console.anthropic.com -> API keys).
# Optional - without it, receipt scanning falls back to regex-based
# extraction, which misses items in many vendor email formats.
ANTHROPIC_API_KEY=
