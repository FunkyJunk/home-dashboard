PORT=3000

# Home Assistant - generate a long-lived access token from your HA profile page
HOME_ASSISTANT_URL=http://homeassistant:8123
HOME_ASSISTANT_TOKEN=

# Weather (Open-Meteo, no key needed - just coordinates)
LAT=
LON=

# Google Calendar / Gmail OAuth (from get-refresh-token.js)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Ring camera snapshots (from get-ring-refresh-token.js)
# This token rotates roughly hourly - if snapshots start failing, re-run the
# script and paste in a fresh value.
RING_REFRESH_TOKEN=
# Optional: comma-separated Ring camera IDs to show. Leave blank to show all
# cameras on the account.
RING_CAMERA_IDS=
